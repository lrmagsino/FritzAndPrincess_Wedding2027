# Leave the base path empty for local development. GitHub Pages sets this in its workflow.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=https://lrmagsino.github.io/FritzAndPrincess_Wedding2027

# Supabase publishable credentials are public and protected by the wishes table's RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional override for the RSVP Google Form URL.
NEXT_PUBLIC_RSVP_FORM_URL=https://forms.gle/qqcTjS8X8AhS7Vbe9
NEXT_PUBLIC_RSVP_EMBED_URL=https://docs.google.com/forms/d/e/1FAIpQLSdfjFmsCtfLXTcq96DChlf0-A3s1eAneHLOFg47Dbboylpk3Q/viewform?embedded=true

# Optional overrides for the supplied venue Google Maps links.
NEXT_PUBLIC_CEREMONY_MAP_URL=https://maps.app.goo.gl/GQvUGWgypgrqnHnE6
NEXT_PUBLIC_RECEPTION_MAP_URL=https://maps.app.goo.gl/g5DfCtYthcWQqNfG9
